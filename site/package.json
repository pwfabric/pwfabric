{
  "name": "pwfabric-site",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "PWFabric — the engine documentation site (pwfabric.com)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3008",
    "build": "next build && node scripts/sitemap.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "next": "15.5.27",
    "nextra": "3.3.1",
    "nextra-theme-docs": "3.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "typescript": "^5.4.0"
  }
}
