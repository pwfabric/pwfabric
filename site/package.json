{
  "name": "pwfabric-site",
  "version": "3.3.0",
  "private": true,
  "description": "PWFabric — the engine documentation site (pwfabric.com)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3008",
    "build": "next build && pagefind --site .next/server/app --output-path out/_pagefind && node scripts/sitemap.mjs && node scripts/llms.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out"
  },
  "dependencies": {
    "next": "15.5.29",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.29",
    "pagefind": "1.6.0",
    "typescript": "^5.4.0"
  }
}
