{
  "name": "@pwfabric/authoring",
  "version": "1.0.0-rc.0",
  "description": "Authoring surface for PWFabric — define blocks, factories and capabilities",
  "type": "module",
  "license": "Apache-2.0",
  "author": "PhiMajor Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwfabric/pwfabric.git",
    "directory": "packages/authoring"
  },
  "homepage": "https://github.com/pwfabric/pwfabric#readme",
  "bugs": {
    "url": "https://github.com/pwfabric/pwfabric/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pwfabric/contracts": "workspace:*",
    "@pwfabric/core": "workspace:*",
    "@pwfabric/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "react": "^19.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
