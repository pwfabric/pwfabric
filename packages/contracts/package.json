{
  "name": "@pwfabric/contracts",
  "version": "3.3.1",
  "description": "PWFabric contract definitions and interfaces",
  "type": "module",
  "license": "Apache-2.0",
  "author": "PhiMajor Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwfabric/pwfabric.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/pwfabric/pwfabric#readme",
  "bugs": {
    "url": "https://github.com/pwfabric/pwfabric/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js",
      "default": "./dist/pack.js"
    },
    "./record-write": {
      "types": "./dist/fabric/record-write.d.ts",
      "import": "./dist/fabric/record-write.js",
      "default": "./dist/fabric/record-write.js"
    },
    "./webfonts": {
      "types": "./dist/fabric/webfonts.d.ts",
      "import": "./dist/fabric/webfonts.js",
      "default": "./dist/fabric/webfonts.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
