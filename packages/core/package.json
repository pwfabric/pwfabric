{
  "name": "@pwfabric/core",
  "version": "3.8.0",
  "description": "PWFabric core functionality and utilities",
  "type": "module",
  "license": "BUSL-1.1",
  "author": "PhiMajor Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwfabric/pwfabric.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pwfabric/pwfabric#readme",
  "bugs": {
    "url": "https://github.com/pwfabric/pwfabric/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring/index.d.ts",
      "import": "./dist/monitoring/index.js",
      "default": "./dist/monitoring/index.js"
    },
    "./config-schema": {
      "types": "./dist/config-schema-builder.d.ts",
      "import": "./dist/config-schema-builder.js",
      "default": "./dist/config-schema-builder.js"
    },
    "./host-imports": {
      "types": "./dist/blocks/host-imports.d.ts",
      "import": "./dist/blocks/host-imports.js",
      "default": "./dist/blocks/host-imports.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pwfabric/contracts": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.4.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
