{
  "name": "@pwfabric/embed",
  "version": "1.0.0-rc.0",
  "description": "Portable embed runtime — renders a PWFabric CanonicalSurface anywhere (thin or fully-offline fat mode) using the real SurfaceRenderer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed.js": "./dist/embed.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@pwfabric/contracts": "workspace:*",
    "@pwfabric/runtime": "workspace:*",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@pwfabric/authoring": "workspace:*",
    "@pwfabric/core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pwfabric/pwfabric",
    "directory": "packages/embed"
  },
  "homepage": "https://github.com/pwfabric/pwfabric#readme",
  "bugs": {
    "url": "https://github.com/pwfabric/pwfabric/issues"
  },
  "license": "BUSL-1.1",
  "author": "PhiMajor Solutions"
}
