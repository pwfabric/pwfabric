{
  "name": "@pwfabric/runner",
  "version": "1.0.0-rc.0",
  "description": "pwapp runner — browser ES module that runs a pwpack source envelope at RUNTIME (hash/path router, navigation assembly, PKCE auth bridge) on top of the @pwfabric/embed fat-mode renderer",
  "type": "module",
  "private": false,
  "main": "./dist/runner.js",
  "exports": {
    ".": {
      "default": "./dist/runner.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pwfabric/contracts": "workspace:*",
    "@pwfabric/runtime": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pwfabric/pwfabric",
    "directory": "packages/runner"
  },
  "homepage": "https://github.com/pwfabric/pwfabric#readme",
  "bugs": {
    "url": "https://github.com/pwfabric/pwfabric/issues"
  },
  "license": "BUSL-1.1",
  "author": "PhiMajor Solutions"
}
