{
  "name": "pwfabric",
  "version": "3.2.0",
  "private": true,
  "description": "PWFabric — the engine monorepo for the @pwfabric/* packages (contracts, core, runtime, embed, runner, pack, compiler, authoring, cli)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "publish": "pnpm -r publish --no-git-checks",
    "spec:conformance": "node scripts/spec-conformance.mjs",
    "smoke:cli": "node scripts/cli-smoke.mjs",
    "check:hydration": "node scripts/hydration-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "playwright": "1.60.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "baseline-browser-mapping@<2.11.0": "^2.11.37",
      "brace-expansion@<1.1.21": "^1.1.22",
      "brace-expansion@>=4 <5.0.12": "^5.0.13",
      "dompurify@<3.4.17": "^3.4.18",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2",
      "fast-uri@<3.1.9": "^3.1.9",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "katex@<0.18.2": "^0.18.2",
      "minimatch@>=7 <11.0.1": "^11.0.8",
      "nanoid@<3.3.18": "^3.3.20",
      "postcss@<8.5.23": "^8.5.33",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "ws@>=8 <8.21.0": "^8.23.0"
    },
    "patchedDependencies": {
      "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs@4.6.1.patch"
    }
  }
}
