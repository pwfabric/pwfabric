{
  "name": "pwfabric",
  "version": "1.1.0",
  "private": true,
  "description": "PWFabric — the engine monorepo for the @pwfabric/* packages (contracts, core, runtime, embed, runner, pack, compiler, authoring, cli)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "publish": "pnpm -r publish --no-git-checks",
    "spec:conformance": "node scripts/spec-conformance.mjs",
    "smoke:cli": "node scripts/cli-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.27.0"
}
